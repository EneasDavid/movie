# Copy this file to .env and fill in real values for local development.
# In production (Vercel), set these under Project Settings > Environment
# Variables instead — .env is never read there, it's gitignored and local-only.

# --- Google Drive (required) ---
# Create at https://console.cloud.google.com/apis/credentials — "API key",
# then restrict it to the "Google Drive API" (enable that API on the same
# project first). No OAuth/service account needed: the target folder must
# be shared as "Anyone with the link" (Viewer) for this to work.
GOOGLE_DRIVE_API_KEY=
# The ID from the folder's URL: drive.google.com/drive/folders/<THIS_PART>
GOOGLE_DRIVE_FOLDER_ID=

# --- Upstash Redis (recommended; app degrades gracefully without it — see README) ---
# Vercel: Storage tab -> Create Database -> Upstash, which injects these
# automatically. Standalone: create at https://upstash.com (free tier),
# copy the REST URL/token from the database's Details page.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Server (optional, sensible defaults in internal/config) ---
PORT=8080
CATALOG_TTL=5m
THUMBNAIL_TTL=30m
CHUNK_SIZE_BYTES=1048576
CHUNK_TTL=20m
RATE_LIMIT_PER_WINDOW=60
RATE_LIMIT_WINDOW=10s
DRIVE_MAX_INFLIGHT=8


# configurações para disparo de email
#https://resend.com/onboarding
RESEND_API_KEY=seu_api_key_da_resend
# Precisa ser um endereço válido ("Nome <endereco@dominio>" ou
# "endereco@dominio") — faltar o "@" faz TODO envio falhar com 422 e cair
# de volta pro LogMailer (só loga, não envia de verdade). O domínio
# também precisa estar verificado no Resend; sem isso, use o domínio de
# teste padrão deles abaixo, que funciona sem verificação.
EMAIL_FROM="df-orfeu <onboarding@resend.dev>"
PUBLIC_BASE_URL=https://df-orfeu.vercel.app